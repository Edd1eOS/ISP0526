{
    "name": "isp0526",
    "version": "0.0.0",
    "private": true,
    "description": "ISP0526 - one-stop study-abroad launcher (Phase 1: AI school recommendation)",
    "engines": {
        "node": ">=22.13",
        "pnpm": ">=11"
    },
    "packageManager": "pnpm@11.2.2",
    "scripts": {
        "lint": "pnpm -r --if-present lint",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "pnpm -r --if-present test",
        "build": "pnpm -r --if-present build",
        "dev": "pnpm --filter @isp0526/web dev",
        "pipeline": "npm run pipeline --workspace=@isp0526/data-pipeline",
        "benchmark": "node test-300-statistical.js"
    }
}